# Normalize text files to LF in the repository and the working tree
* text=auto eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Unix scripts must stay LF
gradlew text eol=lf
*.sh    text eol=lf

# Binary files
*.jar      binary
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.webp     binary
*.ico      binary
*.ttf      binary
*.otf      binary
*.woff     binary
*.woff2    binary
*.mp4      binary
*.pdf      binary
*.keystore binary
*.jks      binary
